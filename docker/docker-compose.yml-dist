services:
    app-server:
        build: images/apache
        image: puzzle-amqp/app-server
        volumes:
            - ..:/var/www/puzzle-amqp
            - ./images/apache/php.ini:/usr/local/etc/php/conf.d/php.ini
        links:
            - rabbitmq
        stop_signal: SIGKILL
        command: tail -f /dev/null
    rabbitmq:
        image: rabbitmq:3-management-alpine
        ports:
            - "${RMQ_PORT}:15672"
            - "<%amqp.port%>:5672"
